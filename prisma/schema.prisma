generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  name               String
  password           String
  role               String   @default("EMPLOYEE")
  education          String?
  idCard             String?
  phone              String?
  salary             Float?
  educationSalary    Float?   @default(0)
  level              String?
  departmentId       String?
  positionId         String?
  startDate          DateTime?
  seniorityStartDate DateTime?
  seniorityEndDate   DateTime?
  companyId          String?
  company            Company? @relation(fields: [companyId], references: [id])
  resumeDoc          String?
  partyInfoDoc       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  overtimeApplications OvertimeApplication[]
  leaveApplications    LeaveApplication[]
  performanceReviews   PerformanceReview[] @relation("Reviewer")
  reviewedPerformance  PerformanceReview[] @relation("Reviewee")
  approvals            Approval[]
  leaveBalance         LeaveBalance?
  salaryRecords        SalaryRecord[]
  overtimeSettlements  OvertimeSettlement[]
  otherApplications    OtherApplication[]
  resumeVersions       UserResumeVersion[]
  partyInfoVersions    UserPartyInfoVersion[]
  profileChangeLogs    UserProfileChangeLog[]   @relation("ProfileChangeOwner")
  createdProfileChangeLogs UserProfileChangeLog[] @relation("ProfileChangeActor")

  department Department? @relation(fields: [departmentId], references: [id])
  position   Position?   @relation(fields: [positionId], references: [id])

  @@map("users")
}

model Company {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  address     String?
  contact     String?
  phone       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  departments Department[]

  @@map("companies")
}

model OvertimeApplication {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  startTime       DateTime
  endTime         DateTime
  hours           Float
  // 实际加班时间（确认阶段填写）
  actualStartTime DateTime?
  actualEndTime   DateTime?
  actualHours     Float?
  type            String   @default("WORKDAY")
  reason          String
  // 状态: DRAFT(草稿), PENDING(事前审批中), PRE_APPROVED(事前通过待确认), CONFIRM_PENDING(确认审批中), COMPLETED(已完成), REJECTED(已退回)
  status          String   @default("DRAFT")
  // 当前流程阶段: PRE(事前审批), CONFIRM(确认审批)
  currentPhase    String   @default("PRE")
  approverId      String?
  approvedAt      DateTime?
  remark          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  overtimeSettlements OvertimeSettlement[]

  @@index([userId, status, date])
  @@index([status, createdAt])
  @@map("overtime_applications")
}

model LeaveApplication {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  startSession   String?
  endSession     String?
  halfDaySession String?
  startDate      DateTime
  endDate        DateTime
  days           Float
  reason         String
  destination    String?
  status         String   @default("DRAFT")
  approverId     String?
  approvedAt     DateTime?
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, status, startDate])
  @@index([status, createdAt])
  @@map("leave_applications")
}

model LeaveBalance {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year              Int
  annual            Float    @default(5)
  annualEntitlement Float    @default(5)
  sick              Float    @default(10)
  personal          Float    @default(5)
  compensatory      Float    @default(0)
  usedCompensatory  Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([year])
  @@map("leave_balances")
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  year      Int
  type      String
  createdAt DateTime @default(now())

  @@index([year])
  @@index([date])
  @@map("holidays")
}

model SalaryRecord {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month                String
  baseSalary           Float
  seniorityPay         Float    @default(0)
  otherAdjustment      Float    @default(0)
  adjustmentNote       String?
  workdayOvertimeHours Float    @default(0)
  workdayOvertimePay   Float    @default(0)
  weekendOvertimeHours Float    @default(0)
  weekendOvertimePay   Float    @default(0)
  holidayOvertimeHours Float    @default(0)
  holidayOvertimePay   Float    @default(0)
  totalOvertimePay     Float    @default(0)
  compensatoryHours    Float    @default(0)
  deduction            Float    @default(0)
  netSalary            Float
  status               String   @default("DRAFT")
  paidAt               DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  overtimeSettlements OvertimeSettlement[]

  @@unique([userId, month])
  @@index([month, status])
  @@map("salary_records")
}

model OvertimeSettlement {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  overtimeId     String
  overtime       OvertimeApplication  @relation(fields: [overtimeId], references: [id], onDelete: Cascade)
  salaryRecordId String?
  salaryRecord   SalaryRecord?        @relation(fields: [salaryRecordId], references: [id], onDelete: SetNull)
  hours          Float
  settlementType String
  createdAt      DateTime @default(now())

  @@index([overtimeId, settlementType])
  @@index([salaryRecordId])
  @@index([userId, settlementType, createdAt])
  @@map("overtime_settlements")
}

model PerformanceReview {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("Reviewee", fields: [userId], references: [id], onDelete: Cascade)
  period      String
  quality     Int
  efficiency  Int
  attitude    Int
  skill       Int
  teamwork    Int
  totalScore  Float
  comment     String?
  selfComment String?
  reviewerId  String?
  reviewer    User?    @relation("Reviewer", fields: [reviewerId], references: [id])
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, period])
  @@index([status, period])
  @@map("performance_reviews")
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  positions     Position[]
  approvalFlows ApprovalFlow[]

  @@map("departments")
}

model ApprovalFlow {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name         String
  types        String
  config       String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([departmentId, isActive])
  @@map("approval_flows")
}

model Approval {
  id              String   @id @default(cuid())
  applicationId   String
  applicationType String
  applicantId     String
  approverId      String
  approver        User     @relation(fields: [approverId], references: [id])
  status          String
  remark          String?
  createdAt       DateTime @default(now())

  @@index([applicationType, applicationId, createdAt])
  @@index([approverId, createdAt])
  @@index([applicantId, createdAt])
  @@map("approvals")
}

model UserProfileChangeLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("ProfileChangeOwner", fields: [userId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User     @relation("ProfileChangeActor", fields: [actorId], references: [id])
  actionType  String
  summary     String
  remark      String?
  changes     Json
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@index([actionType, createdAt])
  @@map("user_profile_change_logs")
}

model OtherApplication {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  content     String
  attachments String?
  versionRemark String?
  status      String   @default("DRAFT")
  approverId  String?
  approvedAt  DateTime?
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([type, status])
  @@map("other_applications")
}

model UserResumeVersion {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment    String
  remark        String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([userId, effectiveFrom])
  @@index([userId, effectiveTo])
  @@map("user_resume_versions")
}

model UserPartyInfoVersion {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment    String
  remark        String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([userId, effectiveFrom])
  @@index([userId, effectiveTo])
  @@map("user_party_info_versions")
}

model Position {
  id                  String     @id @default(cuid())
  name                String
  departmentId        String
  department          Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  baseSalary          Float
  hasSeniorityPay     Boolean    @default(true)
  seniorityPayPerYear Float      @default(100)
  maxSeniorityPay     Float      @default(1000)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  users User[]

  @@unique([departmentId, name])
  @@map("positions")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   // HTML 格式，支持表格
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}
