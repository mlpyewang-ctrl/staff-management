cd ~/staff-management-v1
node -e "const fs=require('fs'),{PrismaClient}=require('@prisma/client'),p=new PrismaClient(),d=JSON.parse(fs.readFileSync('prisma/seed-data.json','utf8'));(async()=>{await p.company.createMany({data:d.companies,skipDuplicates:true});await p.department.createMany({data:d.departments,skipDuplicates:true});await p.position.createMany({data:d.positions,skipDuplicates:true});await p.user.createMany({data:d.users,skipDuplicates:true});console.log('完成: 公司'+d.companies.length+', 部门'+d.departments.length+', 岗位'+d.positions.length+', 用户'+d.users.length);await p.\$disconnect()})();"
