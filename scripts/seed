cd ~/staff-management-v1
node -e "const{PrismaClient}=require('@prisma/client'),bcrypt=require('bcryptjs'),p=new PrismaClient();(async()=>{const h=await bcrypt.hash('admin123',10);await p.user.upsert({where:{username:'admin'},update:{password:h},create:{username:'admin',name:'系统管理员',password:h,role:'ADMIN'}});console.log('admin / admin123');await p.\$disconnect()})();"