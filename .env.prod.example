## Prisma / App database connection (external PostgreSQL)
DATABASE_URL="postgresql://staff:change_me@your-db-host:5432/staff_management?schema=public"

## NextAuth.js Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace_with_a_random_secret"
NEXTAUTH_URL="http://your-server-ip:3000"

## Timezone
TZ=Asia/Shanghai

## Auto-run Prisma db push on startup
RUN_DB_PUSH=true

## Auto-run seed on startup (usually false for production)
RUN_DB_SEED=false
